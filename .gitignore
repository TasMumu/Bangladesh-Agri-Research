# ── Data directories (too large for GitHub) ───────────────────────
data/
outputs/maps/*.html

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Jupyter ───────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Virtual environments ──────────────────────────────────────────
venv/
env/
.env
.venv

# ── OS files ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── Credentials (never commit these) ─────────────────────────────
.cdsapirc
*.cdsapirc
secrets.toml
.streamlit/secrets.toml

# dbt artifacts
target/
logs/
dev.duckdb
dbt_project.yml

# Claude local config
.claude/
# v2 build scratch
v2/paper/_render/
v2/logs/*.md5
# v2 pipeline data is versioned (the top-level data/ rule would hide it)
!v2/data/
